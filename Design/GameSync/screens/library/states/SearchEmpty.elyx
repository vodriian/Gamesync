import "tokens/desktop.elyx" as c
import "blocks/shell/LibraryShell.elyx" as librarySource
import "tokens/typography.elyx" as typography

export SearchEmpty = frame : librarySource.Library {
  doc: "04 · Empty, loading and errors / SearchEmpty",
  left: 0px,
  top: 0px,

  librarySource.Library.panel {
    librarySource.Library.panel.count {
      contents: "0 games · ⓘ"
    }

    librarySource.Library.panel.toolbar {
      librarySource.Library.panel.toolbar.search {
        librarySource.Library.panel.toolbar.search.value {
          contents: "⌕  no matching title"
        }
      }
    }

    librarySource.Library.panel.body {
      overrides: [insert(content, after = .nil)]
    }
  }

  content = frame {
    left: 290px,
    top: 280px,
    width: 440px,
    layout: {direction: .column, item-gap: 16px},
    children: [title, hint],

    title = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "No games found",
      font-size: typography.size.heading,
      font-family: typography.family.interface
    }

    hint = text {
      left: 0px,
      top: 0px,
      width: 420px,
      fill: c.ui.muted,
      contents: "Try a different search or filter.",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }
  }
}
