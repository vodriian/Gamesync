import "tokens/desktop.elyx" as c
import "blocks/shell/LibraryShell.elyx" as librarySource
import "tokens/typography.elyx" as typography
import "controls/Button.elyx" as buttons

export LibraryEmpty = frame : librarySource.Library {
  doc: "04 · Empty, loading and errors / LibraryEmpty",
  left: 0px,
  top: 0px,

  librarySource.Library.panel {
    librarySource.Library.panel.count {
      contents: "0 games · ⓘ"
    }

    librarySource.Library.panel.body {
      overrides: [insert(content, after = .nil)]
    }
  }

  content = frame {
    left: 290px,
    top: 280px,
    width: 440px,
    layout: {direction: .column, item-gap: 16px},
    children: [title, hint, connect],

    title = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "No games yet",
      font-size: typography.size.heading,
      font-family: typography.family.interface
    }

    hint = text {
      left: 0px,
      top: 0px,
      width: 420px,
      fill: c.ui.muted,
      contents: "Connect Steam to import your games.",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    connect = frame : buttons.Primary {
      left: 0px,
      top: 0px,

      buttons.Button.label {
        contents: "Connect Steam"
      }
    }
  }
}
