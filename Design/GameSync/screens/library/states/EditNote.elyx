import "tokens/desktop.elyx" as c
import "resources/images/646570.jpg" as cover646570
import "resources/images/1145360.jpg" as cover1145360
import "resources/images/367520.jpg" as cover367520
import "resources/images/2379780.jpg" as cover2379780
import "resources/images/620.jpg" as cover620
import "resources/images/632360.jpg" as cover632360
import "resources/images/1055540.jpg" as cover1055540
import "resources/images/1091500.jpg" as cover1091500
import "blocks/shell/LibraryShell.elyx" as librarySource
import "tokens/typography.elyx" as typography
import "tokens/radius.elyx" as radius
import "blocks/library/GridTile.elyx" as gridTileSource
import "controls/Button.elyx" as buttons

export EditNote = frame : librarySource.Library {
  doc: "03 · Selection and editing / EditNote",
  left: 0px,
  top: 0px,

  librarySource.Library.panel {
    librarySource.Library.panel.body {
      overrides: [insert(content, after = .nil)]
    }
  }

  librarySource.Library.overlay {
    overrides: [insert(popover, after = .nil)]
  }

  content = frame {
    left: 0px,
    top: 0px,
    width: 970px,
    layout: {item-gap: 23px, wrap: .true, line-gap: 22px},
    children: [game0, game1, game2, game3, game4, game5, game6, game7, game8],

    game0 = frame : gridTileSource.GridTile {
      left: 0px,
      top: 0px,

      gridTileSource.GridTile.meta {
        contents: "Playing    ★ 4.5"
      }
    }

    game1 = frame : gridTileSource.GridTile {
      left: 0px,
      top: 0px,

      gridTileSource.GridTile.cover {
        fill[0].image.ref: cover646570
      }

      gridTileSource.GridTile.meta {
        contents: "Playing    ★ 4.5"
      }

      gridTileSource.GridTile.title {
        contents: "Slay the Spire"
      }
    }

    game2 = frame : gridTileSource.GridTile {
      left: 0px,
      top: 0px,

      gridTileSource.GridTile.cover {
        fill[0].image.ref: cover1145360
      }

      gridTileSource.GridTile.meta {
        contents: "Want to play    ★ 5.0"
      }

      gridTileSource.GridTile.title {
        contents: "Hades"
      }
    }

    game3 = frame : gridTileSource.GridTile {
      left: 0px,
      top: 0px,

      gridTileSource.GridTile.cover {
        fill[0].image.ref: cover367520
      }

      gridTileSource.GridTile.meta {
        contents: "Paused    ★ 4.5"
      }

      gridTileSource.GridTile.title {
        contents: "Hollow Knight"
      }
    }

    game4 = frame : gridTileSource.GridTile {
      left: 0px,
      top: 0px,

      gridTileSource.GridTile.cover {
        fill[0].image.ref: cover2379780
      }

      gridTileSource.GridTile.meta {
        contents: "Playing    ★ 4.5"
      }

      gridTileSource.GridTile.title {
        contents: "Balatro"
      }
    }

    game5 = frame : gridTileSource.GridTile {
      left: 0px,
      top: 0px,

      gridTileSource.GridTile.cover {
        fill[0].image.ref: cover620
      }

      gridTileSource.GridTile.meta {
        contents: "Completed    ★ 5.0"
      }

      gridTileSource.GridTile.title {
        contents: "Portal 2"
      }
    }

    game6 = frame : gridTileSource.GridTile {
      left: 0px,
      top: 0px,

      gridTileSource.GridTile.cover {
        fill[0].image.ref: cover632360
      }

      gridTileSource.GridTile.meta {
        contents: "Dropped    ★ 3.0"
      }

      gridTileSource.GridTile.title {
        contents: "Risk of Rain 2"
      }
    }

    game7 = frame : gridTileSource.GridTile {
      left: 0px,
      top: 0px,

      gridTileSource.GridTile.cover {
        fill[0].image.ref: cover1055540
      }

      gridTileSource.GridTile.meta {
        contents: "Completed    ★ 4.5"
      }

      gridTileSource.GridTile.title {
        contents: "A Short Hike"
      }
    }

    game8 = frame : gridTileSource.GridTile {
      left: 0px,
      top: 0px,

      gridTileSource.GridTile.cover {
        fill[0].image.ref: cover1091500
      }

      gridTileSource.GridTile.meta {
        contents: "Backlog    ★ —"
      }

      gridTileSource.GridTile.title {
        contents: "Cyberpunk 2077"
      }
    }
  }

  popover = frame {
    left: 430px,
    top: 270px,
    width: 440px,
    height: 290px,
    fill: c.ui.surface,
    border: c.ui.border,
    shadow: {
      drop-shadow: {
        color: rgb(0%, 0%, 0%, 18.82%),
        offset: point(0px, 12px),
        blur-radius: 30px
      }
    },
    corner-radius: radius.corner.panel,
    padding: 20px,
    children: form,

    form = frame {
      left: 0px,
      top: 0px,
      width: 400px,
      layout: {direction: .column, item-gap: 14px},
      children: [title, label, input, actions],

      title = text {
        left: 0px,
        top: 0px,
        fill: c.ui.text,
        contents: "Stardew Valley",
        font-size: typography.size.heading,
        font-family: typography.family.interface
      }

      label = text {
        left: 0px,
        top: 0px,
        fill: c.ui.text,
        contents: "Notes",
        font-size: typography.size.body,
        font-family: typography.family.interface
      }

      input = frame {
        left: 0px,
        top: 0px,
        width: 400px,
        height: 130px,
        border: c.ui.border,
        corner-radius: radius.corner.control,
        padding: 10px,
        children: value,

        value = text {
          left: 0px,
          top: 0px,
          fill: c.ui.text,
          contents: "Finish the community center.",
          font-size: typography.size.body,
          font-family: typography.family.interface
        }
      }

      actions = frame {
        left: 0px,
        top: 0px,
        width: 400px,
        layout: {item-gap: 10px},
        children: [cancel, save],

        cancel = frame : buttons.Button {
          left: 0px,
          top: 0px,

          buttons.Button.label {
            contents: "Cancel"
          }
        }

        save = frame : buttons.Primary {
          left: 0px,
          top: 0px,

          buttons.Button.label {
            contents: "Save"
          }
        }
      }
    }
  }
}
