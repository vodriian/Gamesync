import "tokens/desktop.elyx" as c
import "resources/images/646570.jpg" as cover646570
import "resources/images/1145360.jpg" as cover1145360
import "resources/images/367520.jpg" as cover367520
import "resources/images/2379780.jpg" as cover2379780
import "resources/images/620.jpg" as cover620
import "resources/images/632360.jpg" as cover632360
import "resources/images/1055540.jpg" as cover1055540
import "resources/images/1091500.jpg" as cover1091500
import "blocks/shell/LibraryShell.elyx" as librarySource
import "tokens/typography.elyx" as typography
import "tokens/radius.elyx" as radius
import "blocks/library/TableRow.elyx" as tableRowSource
import "controls/Button.elyx" as buttons

export BulkPartialFailure = frame : librarySource.Library {
  left: 0px,
  top: 0px,

  librarySource.Library.overlay {
    overrides: [insert(popover, after = .nil)]
  }

  librarySource.Library.panel {
    librarySource.Library.panel.body {
      overrides: [insert(content, after = .nil)]
    }

    librarySource.Library.panel.toolbar {
      librarySource.Library.panel.toolbar.views {
        librarySource.Library.panel.toolbar.views.table {
          fill[0].color: c.ui.selected
        }

        librarySource.Library.panel.toolbar.views.grid {
          fill[0].color: c.ui.surface
        }
      }
    }
  }

  content = frame {
    left: 0px,
    top: 0px,
    width: 970px,
    layout: {direction: .column},
    children: [
      bulk,
      header,
      row0,
      row1,
      row2,
      row3,
      row4,
      row5,
      row6,
      row7,
      row8
    ],

    bulk = frame {
      left: 0px,
      top: 0px,
      width: 970px,
      layout: {item-gap: 12px},
      children: [count, favorite, status, collections, hide, clear],

      count = text {
        left: 0px,
        top: 0px,
        fill: c.ui.text,
        contents: "3 selected",
        font-size: typography.size.body,
        font-family: typography.family.interface
      }

      favorite = frame : buttons.Button {
        left: 0px,
        top: 0px,

        buttons.Button.label {
          contents: "Favorite"
        }
      }

      status = frame : buttons.Button {
        left: 0px,
        top: 0px,

        buttons.Button.label {
          contents: "Status ⌄"
        }
      }

      collections = frame : buttons.Button {
        left: 0px,
        top: 0px,

        buttons.Button.label {
          contents: "Collections ⌄"
        }
      }

      hide = frame : buttons.Button {
        left: 0px,
        top: 0px,

        buttons.Button.label {
          contents: "Hide"
        }
      }

      clear = frame : buttons.Button {
        left: 0px,
        top: 0px,

        buttons.Button.label {
          contents: "Clear"
        }
      }
    }

    header = frame {
      left: 0px,
      top: 0px,
      width: 970px,
      height: 32px,
      children: [check, title, status, rating, hours],

      check = text {
        left: 12px,
        top: 0px,
        fill: c.ui.muted,
        contents: "☐",
        font-size: typography.size.title,
        font-family: typography.family.interface
      }

      title = text {
        left: 90px,
        top: 0px,
        fill: c.ui.muted,
        contents: "Title",
        font-size: typography.size.caption,
        font-family: typography.family.interface
      }

      status = text {
        left: 584px,
        top: 0px,
        fill: c.ui.muted,
        contents: "Status",
        font-size: typography.size.caption,
        font-family: typography.family.interface
      }

      rating = text {
        left: 740px,
        top: 0px,
        fill: c.ui.muted,
        contents: "Rating",
        font-size: typography.size.caption,
        font-family: typography.family.interface
      }

      hours = text {
        left: 856px,
        top: 0px,
        fill: c.ui.muted,
        contents: "Playtime",
        font-size: typography.size.caption,
        font-family: typography.family.interface
      }
    }

    row0 = frame : tableRowSource.TableRow {
      left: 0px,
      top: 0px,
      fill[0].color: c.ui.selected,

      tableRowSource.TableRow.checkbox {
        fill[0].color: c.ui.accent
      }

      tableRowSource.TableRow.rating {
        contents: "4.5 / 5"
      }
    }

    row1 = frame : tableRowSource.TableRow {
      left: 0px,
      top: 0px,
      fill[0].color: c.ui.selected,

      tableRowSource.TableRow.cover {
        fill[0].image.ref: cover646570
      }

      tableRowSource.TableRow.checkbox {
        fill[0].color: c.ui.accent
      }

      tableRowSource.TableRow.hours {
        contents: "47.8 h"
      }

      tableRowSource.TableRow.rating {
        contents: "4.5 / 5"
      }

      tableRowSource.TableRow.title {
        contents: "Slay the Spire"
      }
    }

    row2 = frame : tableRowSource.TableRow {
      left: 0px,
      top: 0px,
      fill[0].color: c.ui.selected,

      tableRowSource.TableRow.cover {
        fill[0].image.ref: cover1145360
      }

      tableRowSource.TableRow.checkbox {
        fill[0].color: c.ui.accent
      }

      tableRowSource.TableRow.hours {
        contents: "30.5 h"
      }

      tableRowSource.TableRow.rating {
        contents: "5.0 / 5"
      }

      tableRowSource.TableRow.status {
        contents: "Want to play"
      }

      tableRowSource.TableRow.title {
        contents: "Hades"
      }
    }

    row3 = frame : tableRowSource.TableRow {
      left: 0px,
      top: 0px,

      tableRowSource.TableRow.cover {
        fill[0].image.ref: cover367520
      }

      tableRowSource.TableRow.hours {
        contents: "20.7 h"
      }

      tableRowSource.TableRow.rating {
        contents: "4.5 / 5"
      }

      tableRowSource.TableRow.status {
        contents: "Paused"
      }

      tableRowSource.TableRow.title {
        contents: "Hollow Knight"
      }
    }

    row4 = frame : tableRowSource.TableRow {
      left: 0px,
      top: 0px,

      tableRowSource.TableRow.cover {
        fill[0].image.ref: cover2379780
      }

      tableRowSource.TableRow.hours {
        contents: "16.3 h"
      }

      tableRowSource.TableRow.rating {
        contents: "4.5 / 5"
      }

      tableRowSource.TableRow.title {
        contents: "Balatro"
      }
    }

    row5 = frame : tableRowSource.TableRow {
      left: 0px,
      top: 0px,

      tableRowSource.TableRow.cover {
        fill[0].image.ref: cover620
      }

      tableRowSource.TableRow.hours {
        contents: "12.0 h"
      }

      tableRowSource.TableRow.rating {
        contents: "5.0 / 5"
      }

      tableRowSource.TableRow.status {
        contents: "Completed"
      }

      tableRowSource.TableRow.title {
        contents: "Portal 2"
      }
    }

    row6 = frame : tableRowSource.TableRow {
      left: 0px,
      top: 0px,

      tableRowSource.TableRow.cover {
        fill[0].image.ref: cover632360
      }

      tableRowSource.TableRow.hours {
        contents: "4.0 h"
      }

      tableRowSource.TableRow.rating {
        contents: "3.0 / 5"
      }

      tableRowSource.TableRow.status {
        contents: "Dropped"
      }

      tableRowSource.TableRow.title {
        contents: "Risk of Rain 2"
      }
    }

    row7 = frame : tableRowSource.TableRow {
      left: 0px,
      top: 0px,

      tableRowSource.TableRow.cover {
        fill[0].image.ref: cover1055540
      }

      tableRowSource.TableRow.hours {
        contents: "3.0 h"
      }

      tableRowSource.TableRow.rating {
        contents: "4.5 / 5"
      }

      tableRowSource.TableRow.status {
        contents: "Completed"
      }

      tableRowSource.TableRow.title {
        contents: "A Short Hike"
      }
    }

    row8 = frame : tableRowSource.TableRow {
      left: 0px,
      top: 0px,

      tableRowSource.TableRow.cover {
        fill[0].image.ref: cover1091500
      }

      tableRowSource.TableRow.hours {
        contents: "0.0 h"
      }

      tableRowSource.TableRow.rating {
        contents: "— / 5"
      }

      tableRowSource.TableRow.status {
        contents: "Backlog"
      }

      tableRowSource.TableRow.title {
        contents: "Cyberpunk 2077"
      }
    }
  }

  popover = frame {
    left: 287px,
    top: 95px,
    width: 960px,
    height: 38px,
    layout: {align-items: .center},
    fill: c.ui.chrome,
    border: c.ui.border,
    corner-radius: radius.corner.control,
    padding: 10px,
    children: message,

    message = text {
      left: 0px,
      top: 0px,
      fill: c.ui.muted,
      contents: "Some games could not be saved. Failed games remain selected.",
      font-size: 13,
      font-family: typography.family.interface
    }
  }
}
