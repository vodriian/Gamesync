import "tokens/desktop.elyx" as c
import "controls/WindowButtons.elyx" as trafficSource
import "tokens/radius.elyx" as radius
import "blocks/library/PhysicalCard.elyx" as physicalCardSource
import "tokens/typography.elyx" as typography
import "blocks/shell/FocusedShell.elyx" as focusedSource

export CardFrontNoFilmstrip = frame : focusedSource.Focused {
  doc: "08 · Focused card / CardFrontNoFilmstrip",
  left: 0px,
  top: 0px,

  focusedSource.Focused.body {
    overrides: [insert(content, after = .nil)]
  }

  content = frame {
    left: 0px,
    top: 0px,
    width: 1280px,
    height: 900px,
    children: [chrome, panel, card, flip],

    chrome = frame {
      left: 0px,
      top: 0px,
      width: 1280px,
      height: 900px,
      fill: c.ui.chrome,
      children: traffic,

      traffic = frame : trafficSource.Traffic {
        left: 16px,
        top: 16px
      }
    }

    panel = frame {
      left: 8px,
      top: 42px,
      width: 1264px,
      height: 850px,
      fill: c.ui.surface,
      border: c.ui.border,
      corner-radius: radius.corner.panel,
      children: [back, navigation],

      back = text {
        left: 40px,
        top: 25px,
        fill: c.ui.text,
        contents: "←  Back to library",
        font-size: typography.size.title,
        font-family: typography.family.interface
      }

      navigation = text {
        left: 1130px,
        top: 22px,
        fill: c.ui.text,
        contents: "‹     ›",
        font-size: 19,
        font-family: typography.family.interface
      }
    }

    card = frame : physicalCardSource.PhysicalCard {
      left: 450px,
      top: 123px,
      width: 380px,
      height: 572px,

      physicalCardSource.PhysicalCard.rating {
        left: 309px,
        top: 544px
      }

      physicalCardSource.PhysicalCard.shade {
        top: 330px,
        width: 360px,
        height: 200px
      }

      physicalCardSource.PhysicalCard.title {
        top: 475px,
        font-size: 30
      }

      physicalCardSource.PhysicalCard.status {
        top: 540px
      }

      physicalCardSource.PhysicalCard.cover {
        width: 360px,
        height: 520px
      }
    }

    flip = text {
      left: 582px,
      top: 738px,
      fill: c.ui.text,
      contents: "Front     Details",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }
  }
}
