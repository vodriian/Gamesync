export CardFront = frame : focusedSource.Focused {
  doc: "08 · Focused card / CardFront",
  left: 0px,
  top: 0px,

  focusedSource.Focused.body {
    overrides: [insert(content, after = .nil)]
  }

  content = frame {
    left: 0px,
    top: 0px,
    width: 1280px,
    height: 900px,
    children: [chrome, panel, card, flip, filmstrip],

    chrome = frame {
      left: 0px,
      top: 0px,
      width: 1280px,
      height: 900px,
      fill: c.ui.chrome,
      children: traffic,

      traffic = frame : trafficSource.Traffic {
        left: 16px,
        top: 16px
      }
    }

    panel = frame {
      left: 8px,
      top: 42px,
      width: 1264px,
      height: 850px,
      fill: c.ui.surface,
      border: c.ui.border,
      corner-radius: radius.corner.panel,
      children: [back, navigation],

      back = text {
        left: 40px,
        top: 25px,
        fill: c.ui.text,
        contents: "←  Back to library",
        font-size: typography.size.title,
        font-family: typography.family.interface
      }

      navigation = text {
        left: 1130px,
        top: 22px,
        fill: c.ui.text,
        contents: "‹     ›",
        font-size: 19,
        font-family: typography.family.interface
      }
    }

    card = frame : physicalCardSource.PhysicalCard {
      left: 450px,
      top: 123px,
      width: 380px,
      height: 572px,

      physicalCardSource.PhysicalCard.rating {
        left: 309px,
        top: 544px
      }

      physicalCardSource.PhysicalCard.shade {
        top: 330px,
        width: 360px,
        height: 200px
      }

      physicalCardSource.PhysicalCard.title {
        top: 475px,
        font-size: 30
      }

      physicalCardSource.PhysicalCard.status {
        top: 540px
      }

      physicalCardSource.PhysicalCard.cover {
        width: 360px,
        height: 520px
      }
    }

    flip = text {
      left: 582px,
      top: 738px,
      fill: c.ui.text,
      contents: "Front     Details",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    filmstrip = frame {
      left: 9px,
      top: 799px,
      width: 1262px,
      height: 92px,
      layout: {item-gap: 6px},
      fill: c.ui.chrome,
      padding: 8px,
      children: [game0, game1, game2, game3, game4, game5, game6, game7, game8],

      game0 = frame {
        left: 0px,
        top: 0px,
        width: 72px,
        height: 78px,
        fill: {image: {ref: cover413150}},
        corner-radius: 7px
      }

      game1 = frame {
        left: 0px,
        top: 0px,
        width: 72px,
        height: 78px,
        fill: {image: {ref: cover646570}},
        corner-radius: 7px
      }

      game2 = frame {
        left: 0px,
        top: 0px,
        width: 72px,
        height: 78px,
        fill: {image: {ref: cover1145360}},
        corner-radius: 7px
      }

      game3 = frame {
        left: 0px,
        top: 0px,
        width: 72px,
        height: 78px,
        fill: {image: {ref: cover367520}},
        corner-radius: 7px
      }

      game4 = frame {
        left: 0px,
        top: 0px,
        width: 72px,
        height: 78px,
        fill: {image: {ref: cover2379780}},
        corner-radius: 7px
      }

      game5 = frame {
        left: 0px,
        top: 0px,
        width: 72px,
        height: 78px,
        fill: {image: {ref: cover620}},
        corner-radius: 7px
      }

      game6 = frame {
        left: 0px,
        top: 0px,
        width: 72px,
        height: 78px,
        fill: {image: {ref: cover632360}},
        corner-radius: 7px
      }

      game7 = frame {
        left: 0px,
        top: 0px,
        width: 72px,
        height: 78px,
        fill: {image: {ref: cover1055540}},
        corner-radius: 7px
      }

