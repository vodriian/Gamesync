import "tokens/desktop.elyx" as c
import "blocks/navigation/Sidebar.elyx" as sidebarSource
import "tokens/typography.elyx" as typography
import "blocks/shell/LibraryShell.elyx" as librarySource
import "controls/Button.elyx" as buttons

export HomeDisconnected = frame : librarySource.Library {
  left: 0px,
  top: 0px,

  librarySource.Library.panel {
    librarySource.Library.panel.body {
      overrides: [insert(content, after = .nil)]
    }

    librarySource.Library.panel.toolbar {
      librarySource.Library.panel.toolbar.search {
        display: .none
      }

      librarySource.Library.panel.toolbar.display {
        display: .none
      }

      librarySource.Library.panel.toolbar.views {
        display: .none
      }

      librarySource.Library.panel.toolbar.title {
        contents: "Home"
      }
    }
  }

  librarySource.Library.sidebar {
    sidebarSource.Sidebar.navigation {
      sidebarSource.Sidebar.navigation.all {
        fill[0]: .nil
      }

      sidebarSource.Sidebar.navigation.home {
        fill[0].color: c.ui.selected
      }
    }
  }

  content = frame {
    left: 0px,
    top: 0px,
    width: 970px,
    layout: {direction: .column, item-gap: 24px},
    children: [
      intro,
      connect,
      recent,
      recentEmpty,
      platforms,
      platformEmpty,
      genres,
      genresEmpty,
      favorites,
      favoritesEmpty,
      collections,
      collectionsEmpty
    ],

    intro = text {
      left: 0px,
      top: 0px,
      width: 540px,
      fill: c.ui.muted,
      contents: "Connect Steam to import your games and playtime.",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    connect = frame : buttons.Primary {
      left: 0px,
      top: 0px,

      buttons.Button.label {
        contents: "Connect Steam"
      }
    }

    recent = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "Continue playing",
      font-size: 15,
      font-family: typography.family.interface
    }

    recentEmpty = text {
      left: 0px,
      top: 0px,
      width: 540px,
      fill: c.ui.muted,
      contents: "Sync Steam to see recent games.",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    platforms = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "Playtime by platform",
      font-size: 15,
      font-family: typography.family.interface
    }

    platformEmpty = text {
      left: 0px,
      top: 0px,
      width: 540px,
      fill: c.ui.muted,
      contents: "No Steam playtime yet.",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    genres = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "Favorite genres",
      font-size: 15,
      font-family: typography.family.interface
    }

    genresEmpty = text {
      left: 0px,
      top: 0px,
      width: 540px,
      fill: c.ui.muted,
      contents: "Genres appear after a Steam sync.",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    favorites = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "Favorite games",
      font-size: 15,
      font-family: typography.family.interface
    }

    favoritesEmpty = text {
      left: 0px,
      top: 0px,
      width: 540px,
      fill: c.ui.muted,
      contents: "Mark games as favorites to see them here.",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    collections = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "Collections",
      font-size: 15,
      font-family: typography.family.interface
    }

    collectionsEmpty = text {
      left: 0px,
      top: 0px,
      width: 540px,
      fill: c.ui.muted,
      contents: "Create a collection in the sidebar to see it here.",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }
  }
}
