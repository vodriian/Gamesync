import "tokens/desktop.elyx" as c
import "blocks/shell/SettingsShell.elyx" as settingsSource
import "tokens/typography.elyx" as typography
import "controls/Button.elyx" as buttons
import "controls/TextField.elyx" as fields

export SyncStopConfirmation = frame : settingsSource.Settings {
  left: 0px,
  top: 0px,

  settingsSource.Settings.body {
    overrides: [insert(content, after = .nil)]
  }

  settingsSource.Settings.navigation {
    settingsSource.Settings.navigation.sync {
      fill[0].color: c.ui.selected
    }

    settingsSource.Settings.navigation.general {
      fill[0].color: c.ui.surface
    }
  }

  settingsSource.Settings.section {
    contents: "Sync"
  }

  content = frame {
    left: 0px,
    top: 0px,
    width: 562px,
    layout: {direction: .column, item-gap: 24px},
    children: [
      folder,
      path,
      actions,
      status,
      device,
      save,
      devices,
      list,
      keys,
      keysAction
    ],

    folder = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "Folder",
      font-size: typography.size.title,
      font-family: typography.family.interface
    }

    path = text {
      left: 0px,
      top: 0px,
      width: 540px,
      fill: c.ui.muted,
      contents: "Sample sync folder / GameSync Sync",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    actions = frame {
      left: 0px,
      top: 0px,
      width: 540px,
      layout: {item-gap: 12px},
      children: [sync, show, stop],

      sync = frame : buttons.Primary {
        left: 0px,
        top: 0px,

        buttons.Button.label {
          contents: "Sync now"
        }
      }

      show = frame : buttons.Button {
        left: 0px,
        top: 0px,

        buttons.Button.label {
          contents: "Show folder"
        }
      }

      stop = frame : buttons.Button {
        left: 0px,
        top: 0px,

        buttons.Button.label {
          contents: "Stop anyway"
        }
      }
    }

    status = text {
      left: 0px,
      top: 0px,
      width: 540px,
      fill: c.ui.muted,
      contents: "3 changes on this device are not in the folder yet. Stop anyway to discard them from sync; your library keeps them.",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    device = frame {
      left: 0px,
      top: 0px,
      width: 260px,
      layout: {direction: .column, item-gap: 10px},
      children: [label, input],

      label = text {
        left: 0px,
        top: 0px,
        fill: c.ui.text,
        contents: "This device",
        font-size: typography.size.body,
        font-family: typography.family.interface
      }

      input = frame : fields.TextField {
        left: 0px,
        top: 0px,
        width: 260px,

        fields.TextField.value {
          contents: "My Mac"
        }
      }
    }

    save = frame : buttons.Button {
      left: 0px,
      top: 0px,

      buttons.Button.label {
        contents: "Save name"
      }
    }

    devices = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "Devices",
      font-size: typography.size.title,
      font-family: typography.family.interface
    }

    list = text {
      left: 0px,
      top: 0px,
      width: 540px,
      fill: c.ui.muted,
      contents: "My Mac (this device) · macOS\nGaming PC · Linux",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    keys = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "API keys",
      font-size: typography.size.title,
      font-family: typography.family.interface
    }

    keysAction = frame : buttons.Button {
      left: 0px,
      top: 0px,

      buttons.Button.label {
        contents: "Turn on key sync"
      }
    }
  }
}
