import "tokens/desktop.elyx" as c
import "blocks/shell/SettingsShell.elyx" as settingsSource
import "tokens/typography.elyx" as typography
import "controls/Button.elyx" as buttons

export SyncSampleUnavailable = frame : settingsSource.Settings {
  left: 0px,
  top: 0px,

  settingsSource.Settings.body {
    overrides: [insert(content, after = .nil)]
  }

  settingsSource.Settings.navigation {
    settingsSource.Settings.navigation.sync {
      fill[0].color: c.ui.selected
    }

    settingsSource.Settings.navigation.general {
      fill[0].color: c.ui.surface
    }
  }

  settingsSource.Settings.section {
    contents: "Sync"
  }

  content = frame {
    left: 0px,
    top: 0px,
    width: 562px,
    layout: {direction: .column, item-gap: 24px},
    children: [heading, info, choose],

    heading = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "Sync across devices",
      font-size: typography.size.title,
      font-family: typography.family.interface
    }

    info = text {
      left: 0px,
      top: 0px,
      width: 540px,
      fill: c.ui.muted,
      contents: "Sync is not available for the sample library.",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    choose = frame : buttons.Button {
      left: 0px,
      top: 0px,

      buttons.Button.label {
        contents: "Choose folder…"
      }
    }
  }
}
