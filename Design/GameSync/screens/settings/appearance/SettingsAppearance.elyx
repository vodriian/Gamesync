import "tokens/desktop.elyx" as c
import "blocks/shell/SettingsShell.elyx" as settingsSource
import "tokens/typography.elyx" as typography
import "controls/Button.elyx" as buttons
import "controls/TextField.elyx" as fields

export SettingsAppearance = frame : settingsSource.Settings {
  left: 0px,
  top: 0px,

  settingsSource.Settings.body {
    overrides: [insert(content, after = .nil)]
  }

  settingsSource.Settings.navigation {
    settingsSource.Settings.navigation.appearance {
      fill[0].color: c.ui.selected
    }

    settingsSource.Settings.navigation.general {
      fill[0].color: c.ui.surface
    }
  }

  settingsSource.Settings.section {
    contents: "Look and feel"
  }

  content = frame {
    left: 0px,
    top: 0px,
    width: 562px,
    layout: {direction: .column, item-gap: 24px},
    children: [
      mode,
      lightScheme,
      lightContrast,
      darkScheme,
      darkContrast,
      accent,
      motion,
      hidden
    ],

    mode = frame {
      left: 0px,
      top: 0px,
      width: 540px,
      layout: {direction: .column, item-gap: 12px},
      children: [label, choices],

      label = text {
        left: 0px,
        top: 0px,
        fill: c.ui.text,
        contents: "Mode",
        font-size: typography.size.body,
        font-family: typography.family.interface
      }

      choices = frame {
        left: 0px,
        top: 0px,
        width: 540px,
        layout: {item-gap: 8px},
        children: [auto, light, dark],

        auto = frame : buttons.Primary {
          left: 0px,
          top: 0px,

          buttons.Button.label {
            contents: "Auto"
          }
        }

        light = frame : buttons.Button {
          left: 0px,
          top: 0px,

          buttons.Button.label {
            contents: "Light"
          }
        }

        dark = frame : buttons.Button {
          left: 0px,
          top: 0px,

          buttons.Button.label {
            contents: "Dark"
          }
        }
      }
    }

    lightScheme = frame {
      left: 0px,
      top: 0px,
      width: 540px,
      layout: {direction: .column, item-gap: 10px},
      children: [label, input],

      label = text {
        left: 0px,
        top: 0px,
        fill: c.ui.text,
        contents: "Light color scheme",
        font-size: typography.size.body,
        font-family: typography.family.interface
      }

      input = frame : fields.TextField {
        left: 0px,
        top: 0px,
        width: 540px,

        fields.TextField.value {
          contents: "Sanctum  ⌄"
        }
      }
    }

    lightContrast = frame {
      left: 0px,
      top: 0px,
      width: 540px,
      layout: {direction: .column, item-gap: 10px},
      children: [label, input],

      label = text {
        left: 0px,
        top: 0px,
        fill: c.ui.text,
        contents: "Light contrast",
        font-size: typography.size.body,
        font-family: typography.family.interface
      }

      input = frame : fields.TextField {
        left: 0px,
        top: 0px,
        width: 540px,

        fields.TextField.value {
          contents: "Normal  ⌄"
        }
      }
    }

    darkScheme = frame {
      left: 0px,
      top: 0px,
      width: 540px,
      layout: {direction: .column, item-gap: 10px},
      children: [label, input],

      label = text {
        left: 0px,
        top: 0px,
        fill: c.ui.text,
        contents: "Dark color scheme",
        font-size: typography.size.body,
        font-family: typography.family.interface
      }

      input = frame : fields.TextField {
        left: 0px,
        top: 0px,
        width: 540px,

        fields.TextField.value {
          contents: "Notion  ⌄"
        }
      }
    }

    darkContrast = frame {
      left: 0px,
      top: 0px,
      width: 540px,
      layout: {direction: .column, item-gap: 10px},
      children: [label, input],

      label = text {
        left: 0px,
        top: 0px,
        fill: c.ui.text,
        contents: "Dark contrast",
        font-size: typography.size.body,
        font-family: typography.family.interface
      }

      input = frame : fields.TextField {
        left: 0px,
        top: 0px,
        width: 540px,

        fields.TextField.value {
          contents: "Normal  ⌄"
        }
      }
    }

    accent = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "☑ Interface accent     ☑ Color scheme accent",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    motion = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "☐ Reduce motion",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    hidden = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "☐ Show hidden games in sidebar",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }
  }
}
