import "tokens/desktop.elyx" as c
import "blocks/shell/SettingsShell.elyx" as settingsSource
import "tokens/typography.elyx" as typography
import "controls/Button.elyx" as buttons
import "controls/TextField.elyx" as fields

export AiTested = frame : settingsSource.Settings {
  left: 0px,
  top: 0px,

  settingsSource.Settings.body {
    overrides: [insert(content, after = .nil)]
  }

  settingsSource.Settings.navigation {
    settingsSource.Settings.navigation.ai {
      fill[0].color: c.ui.selected
    }

    settingsSource.Settings.navigation.general {
      fill[0].color: c.ui.surface
    }
  }

  settingsSource.Settings.section {
    contents: "AI"
  }

  content = frame {
    left: 0px,
    top: 0px,
    width: 562px,
    layout: {direction: .column, item-gap: 24px},
    children: [
      preview,
      local,
      ollama,
      providers,
      tabs,
      provider,
      model,
      endpoint,
      actions,
      notice
    ],

    preview = text {
      left: 0px,
      top: 0px,
      width: 540px,
      fill: c.ui.muted,
      contents: "Preview · tests are simulated. Use dummy keys; nothing is saved or sent.",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    local = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "Local models",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    ollama = frame : buttons.Button {
      left: 0px,
      top: 0px,

      buttons.Button.label {
        contents: "Ollama"
      }
    }

    providers = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "API providers",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    tabs = frame {
      left: 0px,
      top: 0px,
      width: 540px,
      layout: {item-gap: 8px},
      children: [openai, claude, grok, gemini],

      openai = frame : buttons.Primary {
        left: 0px,
        top: 0px,

        buttons.Button.label {
          contents: "OpenAI"
        }
      }

      claude = frame : buttons.Button {
        left: 0px,
        top: 0px,

        buttons.Button.label {
          contents: "Claude"
        }
      }

      grok = frame : buttons.Button {
        left: 0px,
        top: 0px,

        buttons.Button.label {
          contents: "Grok"
        }
      }

      gemini = frame : buttons.Button {
        left: 0px,
        top: 0px,

        buttons.Button.label {
          contents: "Gemini"
        }
      }
    }

    provider = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "OpenAI",
      font-size: typography.size.title,
      font-family: typography.family.interface
    }

    model = frame {
      left: 0px,
      top: 0px,
      width: 540px,
      layout: {direction: .column, item-gap: 10px},
      children: [label, input],

      label = text {
        left: 0px,
        top: 0px,
        fill: c.ui.text,
        contents: "Model",
        font-size: typography.size.body,
        font-family: typography.family.interface
      }

      input = frame : fields.TextField {
        left: 0px,
        top: 0px,
        width: 540px,

        fields.TextField.value {
          contents: "Enter model name"
        }
      }
    }

    endpoint = frame {
      left: 0px,
      top: 0px,
      width: 540px,
      layout: {direction: .column, item-gap: 10px},
      children: [label, input],

      label = text {
        left: 0px,
        top: 0px,
        fill: c.ui.text,
        contents: "API key",
        font-size: typography.size.body,
        font-family: typography.family.interface
      }

      input = frame : fields.TextField {
        left: 0px,
        top: 0px,
        width: 540px,

        fields.TextField.value {
          contents: "Enter a dummy API key"
        }
      }
    }

    actions = frame {
      left: 0px,
      top: 0px,
      width: 540px,
      layout: {item-gap: 8px},
      children: [test, add],

      test = frame : buttons.Button {
        left: 0px,
        top: 0px,

        buttons.Button.label {
          contents: "Test key"
        }
      }

      add = frame : buttons.Primary {
        left: 0px,
        top: 0px,

        buttons.Button.label {
          contents: "Add key"
        }
      }
    }

    notice = text {
      left: 0px,
      top: 0px,
      width: 540px,
      fill: c.ui.muted,
      contents: "Simulated test passed. No connection was made.",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }
  }
}
