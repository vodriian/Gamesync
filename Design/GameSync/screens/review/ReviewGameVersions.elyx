import "tokens/desktop.elyx" as c
import "blocks/shell/ReviewShell.elyx" as reviewSource
import "controls/Button.elyx" as buttons
import "tokens/typography.elyx" as typography

export ReviewGameVersions = frame : reviewSource.Review {
  left: 0px,
  top: 0px,

  reviewSource.Review.body {
    overrides: [insert(content, after = .nil)]
  }

  content = frame {
    left: 0px,
    top: 0px,
    width: 562px,
    layout: {direction: .column, item-gap: 24px},
    children: [heading, hint, v1, v1text, v2, v2text, actions],

    heading = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "Review versions",
      font-size: typography.size.heading,
      font-family: typography.family.interface
    }

    hint = text {
      left: 0px,
      top: 0px,
      width: 540px,
      fill: c.ui.muted,
      contents: "Choose a saved version. Other versions stay in history.",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    v1 = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "Version 1",
      font-size: typography.size.title,
      font-family: typography.family.interface
    }

    v1text = text {
      left: 0px,
      top: 0px,
      width: 540px,
      fill: c.ui.muted,
      contents: "Status: Playing\nRating: 4.5\nCollections: Cozy evenings",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    v2 = text {
      left: 0px,
      top: 0px,
      fill: c.ui.text,
      contents: "Version 2",
      font-size: typography.size.title,
      font-family: typography.family.interface
    }

    v2text = text {
      left: 0px,
      top: 0px,
      width: 540px,
      fill: c.ui.muted,
      contents: "Status: Completed\nRating: 5.0\nCollections: Cozy evenings",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    actions = frame {
      left: 0px,
      top: 0px,
      width: 540px,
      layout: {item-gap: 12px},
      children: [keep, read, close],

      keep = frame : buttons.Primary {
        left: 0px,
        top: 0px,

        buttons.Button.label {
          contents: "Keep selected version"
        }
      }

      read = frame : buttons.Button {
        left: 0px,
        top: 0px,

        buttons.Button.label {
          contents: "Read again"
        }
      }

      close = frame : buttons.Button {
        left: 0px,
        top: 0px,

        buttons.Button.label {
          contents: "Close"
        }
      }
    }
  }
}
