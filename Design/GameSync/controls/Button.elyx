import "tokens/desktop.elyx" as c
import "tokens/typography.elyx" as typography
import "tokens/radius.elyx" as radius

export Button = frame {
  left: 0px,
  top: 0px,
  height: 30px,
  layout: {justify-content: .center, align-items: .center},
  fill: c.ui.surface,
  border: c.ui.border,
  corner-radius: radius.corner.control,
  padding: [5px, 12px],
  children: label,

  label = text {
    left: 0px,
    top: 0px,
    fill: c.ui.text,
    contents: "Button",
    font-size: typography.size.body,
    font-family: typography.family.interface
  }
}

@variant
export Primary = frame : Button {
  left: 120px,
  top: 0px,
  fill[0].color: c.ui.selected
}
