import "tokens/radius.elyx" as radius

export Traffic = frame {
  left: 0px,
  top: 0px,
  width: 72px,
  height: 16px,
  layout: {item-gap: 8px},
  children: [close, minimize, zoom],

  close = frame {
    left: 0px,
    top: 0px,
    width: 12px,
    height: 12px,
    fill: rgb(100%, 37.6471%, 34.5098%),
    corner-radius: radius.corner.control
  }

  minimize = frame {
    left: 0px,
    top: 0px,
    width: 12px,
    height: 12px,
    fill: rgb(100%, 74.1176%, 18.0392%),
    corner-radius: radius.corner.control
  }

  zoom = frame {
    left: 0px,
    top: 0px,
    width: 12px,
    height: 12px,
    fill: rgb(15.6863%, 78.43%, 25.098%),
    corner-radius: radius.corner.control
  }
}
