import "tokens/typography.elyx" as typography

export TableRow = frame {
  left: 0px,
  top: 0px,
  width: 970px,
  height: 65px,
  border: {color: c.ui.border, sides: .bottom},
  children: [checkbox, cover, title, status, rating, hours],

  checkbox = frame {
    left: 12px,
    top: 24px,
    width: 15px,
    height: 15px,
    border: c.ui.border,
    corner-radius: 4px
  }

  cover = frame {
    left: 44px,
    top: 10px,
    width: 30px,
    height: 44px,
    fill: {image: {ref: cover413150}},
    corner-radius: 0px
  }

  title = text {
    left: 90px,
    top: 23px,
    fill: c.ui.text,
    contents: "Stardew Valley",
    font-size: typography.size.body,
    font-family: typography.family.interface
  }

  status = text {
    left: 584px,
    top: 23px,
    fill: c.ui.text,
    contents: "Playing",
    font-size: typography.size.body,
    font-family: typography.family.interface
  }

  rating = text {
    left: 740px,
    top: 23px,
    fill: c.ui.text,
    contents: "4.5 / 5 ♥",
    font-size: typography.size.body,
    font-family: typography.family.interface
  }

  hours = text {
    left: 856px,
    top: 23px,
    fill: c.ui.text,
    contents: "70.0 h",
    font-size: typography.size.body,
    font-family: typography.family.interface
  }
}
