  body = frame {
    left: 214px,
    top: 184px,
    width: 562px,
    height: 585px,
    slot: .true
  }

  feedback = text {
    left: 24px,
    top: 92px,
    fill: c.ui.muted,
    contents: "",
    font-size: 13,
    font-family: typography.family.interface
  }
