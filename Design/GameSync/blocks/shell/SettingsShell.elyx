import "resources/icons/bot.svg" as icon_bot
import "controls/WindowButtons.elyx" as trafficSource
import "tokens/radius.elyx" as radius
import "tokens/typography.elyx" as typography

export Settings = frame {
  left: 0px,
  top: 0px,
  width: 820px,
  height: 780px,
  fill: c.ui.surface,
  corner-radius: radius.corner.panel,
  children: [titlebar, heading, navigation, section, body, feedback],

  titlebar = frame {
    left: 0px,
    top: 0px,
    width: 820px,
    height: 34px,
    fill: c.ui.chrome,
    children: traffic,

    traffic = frame : trafficSource.Traffic {
      left: 10px,
      top: 10px
    }
  }

  heading = text {
    left: 24px,
    top: 62px,
    fill: c.ui.text,
    contents: "Settings",
    font-size: 21,
    font-family: typography.family.interface,
    font-style: "Bold"
  }

  navigation = frame {
    left: 0px,
    top: 114px,
    width: 170px,
    height: 666px,
    border: {color: c.ui.border, sides: .right},
    children: [general, sync, appearance, ai],

    general = frame {
      left: 8px,
      top: 8px,
      width: 152px,
      height: 30px,
      layout: {justify-content: .center, align-items: .center},
      fill: c.ui.selected,
      border: c.ui.border,
      corner-radius: radius.corner.control,
      padding: [5px, 12px],
      children: label,

      label = frame {
        left: 0px,
        top: 0px,
        layout: {align-items: .center, item-gap: 10px},
        children: [glyphIcon, label],

        glyphIcon = icon {
          left: 0px,
          top: 0px,
          width: 18px,
          height: 18px,
          fill: c.ui.text,
          contents: icon_settings
        }

        label = text {
          left: 0px,
          top: 0px,
          fill: c.ui.text,
          contents: "General",
          font-size: typography.size.body,
          font-family: typography.family.interface
        }
      }
    }

    sync = frame {
      left: 8px,
      top: 44px,
      width: 152px,
      height: 30px,
      layout: {justify-content: .center, align-items: .center},
      fill: c.ui.surface,
      border: c.ui.border,
      corner-radius: radius.corner.control,
      padding: [5px, 12px],
      children: label,

      label = frame {
        left: 0px,
        top: 0px,
        layout: {align-items: .center, item-gap: 10px},
        children: [glyphIcon, label],

        glyphIcon = icon {
          left: 0px,
          top: 0px,
          width: 18px,
          height: 18px,
          fill: c.ui.text,
          contents: icon_folder
        }

        label = text {
          left: 0px,
          top: 0px,
          fill: c.ui.text,
          contents: "Sync",
          font-size: typography.size.body,
          font-family: typography.family.interface
        }
      }
    }

    appearance = frame {
      left: 8px,
      top: 80px,
      width: 152px,
      height: 30px,
      layout: {justify-content: .center, align-items: .center},
      fill: c.ui.surface,
      border: c.ui.border,
      corner-radius: radius.corner.control,
      padding: [5px, 12px],
      children: label,

      label = frame {
        left: 0px,
        top: 0px,
        layout: {align-items: .center, item-gap: 10px},
        children: [glyphIcon, label],

        glyphIcon = icon {
          left: 0px,
          top: 0px,
          width: 18px,
          height: 18px,
          fill: c.ui.text,
          contents: icon_palette
        }

        label = text {
          left: 0px,
          top: 0px,
          fill: c.ui.text,
          contents: "Look and feel",
          font-size: typography.size.body,
          font-family: typography.family.interface
        }
      }
    }

    ai = frame {
      left: 8px,
      top: 116px,
      width: 152px,
      height: 30px,
      layout: {justify-content: .center, align-items: .center},
      fill: c.ui.surface,
      border: c.ui.border,
      corner-radius: radius.corner.control,
      padding: [5px, 12px],
      children: label,

      label = frame {
        left: 0px,
        top: 0px,
        layout: {align-items: .center, item-gap: 10px},
        children: [glyphIcon, label],

        glyphIcon = icon {
          left: 0px,
          top: 0px,
          width: 18px,
          height: 18px,
          fill: c.ui.text,
          contents: icon_bot
        }

        label = text {
          left: 0px,
          top: 0px,
          fill: c.ui.text,
          contents: "AI",
          font-size: typography.size.body,
          font-family: typography.family.interface
        }
