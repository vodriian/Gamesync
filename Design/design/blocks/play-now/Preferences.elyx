  }

  deal = frame : buttons.Primary {
    width: 100%,
    height: 40px,

    label {
      leading {
        contents: cardsIcon,
        display: .visible
      }

      label {
        contents: "Deal me 3"
      }
    }
  }

  hint = text {
    fill: c.ui.muted,
    contents: "Up to three choices. One optional reshuffle.",
    font-size: 12,
    font-family: typography.family.interface
  }
}

@variant
export BrainDead = frame : Preferences {
  left: 660px,

  energy {
    brain {
      @with-variant(switches.On)
      toggle {
        left: .nil
      }
    }
  }
}

@variant
export MoreOptions = frame : Preferences {
  left: 1320px,

  more {
    label {
      leading {
        contents: downIcon
      }
    }
  }

  options {
    display: .visible
  }
}
