import "tokens/colors.dark.elyx" as darkTheme
import "tokens/colors.elyx" as c
import "resources/images/413150.jpg" as cover413150
import "tokens/typography.elyx" as typography
import "design/controls/IconLabel.elyx" as iconLabel
import "resources/icons-new/solid/star-stroke-rounded-solid.svg" as glyph_0
import "resources/icons-new/solid/heart-stroke-rounded-solid.svg" as glyph_2

export PhysicalCard = frame {
  doc: "Cover, shade and title intentionally overlap as physical artwork.",
  left: 0px,
  top: 0px,
  width: 282px,
  height: 414px,
  layout: {direction: .column, item-gap: 8px},
  fill: c.ui.surface,
  border: c.ui.border,
  shadow: {
    drop-shadow: {
      color: rgb(0%, 0%, 0%, 9.41%),
      offset: point(0px, 12px),
      blur-radius: 22px
    }
  },
  corner-radius: 18px,
  padding: 10px,
  children: [cover, shade, title, footer],

  cover = frame {
    width: 100%,
    height: 364px,
    fill: {image: {ref: cover413150}},
    corner-radius: 7px
  }

  shade = frame {
    left: 10px,
    top: 210px,
    width: 262px,
    height: 164px,
    ignore-stack: .true,
    fill: {
      linear-gradient: {
        angle: 90deg,
        stops: [stop(0%, .transparent), stop(100%, rgb(0%, 0%, 0%, 85.098%))]
      }
    },
    corner-radius: 10px
  }

  title = text {
    left: 27px,
    top: 327px,
    ignore-stack: .true,
    fill: .white,
    contents: "Stardew Valley",
    font-size: 23,
    font-family: "Georgia"
  }

  footer = frame {
    width: 100%,
    height: 22px,
    layout: {justify-content: .space-between, align-items: .center},
    children: [status, rating],

    status = frame {
      width: 90px,
      height: 21px,
      layout: {align-items: .center},
      fill: c.ui.subtle,
      corner-radius: 11px,
      padding: [3px, 7px],
      children: label,

      label = text {
        fill: c.ui.muted,
        contents: "Playing",
        font-size: 10,
        font-family: typography.family.interface
      }
    }

    rating = frame : iconLabel.IconLabel {
      label {
        fill[0].color: c.ui.muted,
        contents: "",
        font-size: 10
      }

      favorite {
        contents: glyph_2,
        sizing: .fill,
        display: .visible
      }

      trailing {
        contents: glyph_0,
        sizing: .fill,
        display: .visible
      }

      detail {
        contents: "4.5",
        display: .visible
      }
    }
  }
}
