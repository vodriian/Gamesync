import "tokens/colors.dark.elyx" as darkTheme
import "tokens/colors.elyx" as c
import "tokens/radius.elyx" as radius
import "tokens/spacing.elyx" as spacing
import "tokens/typography.elyx" as typography
import "design/controls/Button.elyx" as buttons
import "resources/icons-new/gameboy-stroke-rounded.svg" as deckIcon
import "resources/icons-new/computer-stroke-rounded.svg" as pcIcon
import "resources/icons-new/info-stroke-rounded.svg" as infoIcon

export FitScale = frame {
  doc: "Fit for both setups on one scale: Steam Deck grows left from the center mark, PC grows right. Each half is 0–100.",
  left: 0px,
  top: 0px,
  width: 340px,
  layout: {direction: .column, item-gap: spacing.gap.medium},
  fill: c.ui.subtle,
  border: c.ui.border,
  corner-radius: radius.corner.control,
  padding: spacing.inset.small,
  children: [setups, bar, scores, note],

  setups = frame {
    width: 100%,
    layout: {justify-content: .space-between, align-items: .end},
    children: [deck, pc],

    deck = frame {
      layout: {direction: .column, item-gap: spacing.gap.medium},
      children: [glyph, label],

      glyph = icon {
        width: 16px,
        height: 16px,
        fill: c.ui.deck,
        contents: deckIcon
      }

      label = text {
        fill: c.ui.text,
        contents: "Steam Deck",
        font-size: typography.size.body,
        font-family: typography.family.interface,
        font-style: "Medium"
      }
    }

    pc = frame {
      layout: {
        direction: .column,
        align-items: .end,
        item-gap: spacing.gap.medium
      },
      children: [glyph, label],

      glyph = icon {
        width: 16px,
        height: 16px,
        fill: c.ui.pc,
        contents: pcIcon
      }

      label = text {
        fill: c.ui.text,
        contents: "PC",
        font-size: typography.size.body,
        font-family: typography.family.interface,
        font-style: "Medium",
        align: .right
      }
    }
  }

  bar = frame {
    width: 100%,
    height: 12px,
    layout: {align-items: .center},
    children: [deckTrack, center, pcTrack],

    deckTrack = frame {
      width: 100%,
      height: 4px,
      layout: {justify-content: .end},
      fill: c.ui.border,
      corner-radius: 2px,
      children: value,

      value = frame {
        width: 90%,
        height: 100%,
        fill: c.ui.deck,
        corner-radius: 2px
      }
    }

    center = frame {
      doc: "Center mark: zero fit for both setups.",
      width: 4px,
      height: 12px,
      fill: c.ui.selected,
      corner-radius: 6px
    }

    pcTrack = frame {
      width: 100%,
      height: 4px,
      layout: {direction: .row},
      fill: c.ui.border,
      corner-radius: 2px,
      children: value,

      value = frame {
        width: 75%,
        height: 100%,
        fill: c.ui.pc,
        corner-radius: 2px
      }
    }
  }

  scores = frame {
    width: 100%,
    layout: {justify-content: .space-between},
    children: [deck, pc],

    deck = text {
      fill: c.ui.muted,
      contents: "90/100",
      font-size: typography.size.caption,
      font-family: typography.family.interface
    }

    pc = text {
      fill: c.ui.muted,
      contents: "75/100",
      font-size: typography.size.caption,
      font-family: typography.family.interface,
      align: .right
    }
  }

  note = text {
    width: 100%,
    display: .none,
    fill: c.ui.error,
    contents: "Steam Deck does not support its anti-cheat.",
    font-size: typography.size.caption,
    font-family: typography.family.interface
  }
}

export BestOn = frame {
  doc: "Best on, right book page. Always shown. Fit is the only metric; (i) shows a tooltip on hover and opens FitInfo on click.",
  left: 400px,
  top: 0px,
  width: 340px,
  layout: {direction: .column, item-gap: spacing.gap.regular},
  children: [heading, result, scale, preferenceLabel, choices],

  heading = frame {
    width: 100%,
    layout: {justify-content: .space-between, align-items: .center},
    children: [label, source],

    label = text {
      fill: c.ui.muted,
      contents: "Best on",
      font-size: typography.size.caption,
      font-family: typography.family.interface
    }

    source = text {
      fill: c.ui.muted,
      contents: "Steam · checked today",
      font-size: typography.size.caption,
      font-family: typography.family.interface
    }
  }

  result = frame {
    width: 100%,
    layout: {justify-content: .space-between, align-items: .center},
    children: [title, fit],

    title = frame {
      layout: {align-items: .center, item-gap: spacing.gap.medium},
      children: [label, info],

      label = text {
        fill: c.ui.text,
        contents: "Steam Deck",
        font-size: typography.size.heading,
        font-family: typography.family.interface,
        font-style: "Bold"
      }

      info = icon {
        width: 16px,
        height: 16px,
        fill: c.ui.text,
        contents: infoIcon
      }
    }

    fit = text {
      doc: "Fit of the recommended setup. Both shows the higher fit.",
      fill: c.ui.text,
      subrange: {range: [2, 6], font-size: 12},
      contents: "90/100",
      font-size: typography.size.body,
      font-family: typography.family.interface,
      font-style: "Medium"
    }
  }

  scale = frame : FitScale {
    left: .auto,
    top: .auto,
    width: 100%
  }

  preferenceLabel = text {
    fill: c.ui.muted,
    contents: "Your preference",
    font-size: typography.size.caption,
    font-family: typography.family.interface
  }

  choices = frame {
    width: 100%,
    layout: {
      item-gap: spacing.gap.small,
      wrap: .true,
      line-gap: spacing.gap.small
    },
    children: [automatic, deck, pc, both],

    automatic = frame : buttons.Primary {
      left: .auto,
      top: .auto,
      height: 22px,
      padding-top: 2px,
      padding-left: 6px,
      padding-bottom: 2px,
      padding-right: 6px,

      label {
        label {
          contents: "Automatic",
          font-size: typography.size.caption
        }
      }
    }

    deck = frame : buttons.Button {
      height: 22px,
      padding-top: 2px,
      padding-left: 6px,
      padding-bottom: 2px,
      padding-right: 6px,

      label {
        label {
          contents: "Steam Deck",
          font-size: typography.size.caption
        }
      }
    }

    pc = frame : buttons.Button {
      height: 22px,
      padding-top: 2px,
      padding-left: 6px,
      padding-bottom: 2px,
      padding-right: 6px,

      label {
        label {
          contents: "PC",
          font-size: typography.size.caption
        }
      }
    }

    both = frame : buttons.Button {
      height: 22px,
      padding-top: 2px,
      padding-left: 6px,
      padding-bottom: 2px,
      padding-right: 6px,

      label {
        label {
          contents: "Both",
          font-size: typography.size.caption
        }
      }
    }
  }
}

@variant
export BestOnPc = frame : BestOn {
  doc: "A Prefer PC rule moves a Verified game to PC.",
  left: 800px,

  scale {
    bar {
      deckTrack {
        value {
          width: 75%
        }
      }

      pcTrack {
        value {
          width: 100%
        }
      }
    }

    scores {
      deck {
        contents: "75/100"
      }

      pc {
        contents: "100/100"
      }
    }
  }

  result {
    title {
      label {
        contents: "PC"
      }
    }

    fit {
      contents: "100/100"
    }
  }
}

@variant
export BestOnBoth = frame : BestOn {
  doc: "Fits within 15 points of each other.",
  left: 1200px,

  scale {
    bar {
      deckTrack {
        value {
          width: 85%
        }
      }

      pcTrack {
        value {
          width: 80%
        }
      }
    }

    scores {
      deck {
        contents: "85/100"
      }

      pc {
        contents: "80/100"
      }
    }
  }

  result {
    title {
      label {
        contents: "Both"
      }
    }

    fit {
      contents: "85/100"
    }
  }
}

@variant
export BestOnPcOnly = frame : BestOn {
  left: 1600px,

  scale {
    note {
      fill[0].color: c.ui.muted,
      contents: "Needs your Moza R5 wheel.",
      display: .visible
    }

    scores {
      deck {
        fill[0].color: c.ui.error,
        contents: "Blocked"
      }

      pc {
        contents: "85/100"
      }
    }

    setups {
      deck {
        label {
          fill[0].color: c.ui.muted
        }

        glyph {
          fill[0].color: c.ui.muted
        }
      }
    }

    bar {
      pcTrack {
        value {
          width: 85%
        }
      }

      deckTrack {
        value {
          display: .none
        }
      }
    }
  }

  result {
    fit {
      contents: "85/100"
    }

    title {
      label {
        contents: "PC only"
      }
    }
  }
}

@variant
export BestOnNeedsReview = frame : BestOn {
  left: 2000px,

  scale {
    note {
      fill[0].color: c.ui.muted,
      contents: "Valve has not rated this game on Steam Deck yet.",
      display: .visible
    }

    bar {
      deckTrack {
        value {
          display: .none
        }
      }
    }

    scores {
      deck {
        contents: "Unknown"
      }
    }
  }

  result {
    fit {
      fill[0].color: c.ui.muted,
      contents: "–"
    }

    title {
      label {
        contents: "Needs review"
      }
    }
  }

  heading {
    source {
      contents: "Steam · checked 3 days ago"
    }
  }
}

export FitTooltip = frame {
  doc: "Hover tooltip on (i).",
  left: 0px,
  top: 420px,
  layout: {direction: .row},
  fill: c.ui.text,
  corner-radius: radius.corner.control,
  padding: [4px, 8px],
  children: label,

  label = text {
    fill: c.ui.surface,
    contents: "How fit is calculated",
    font-size: typography.size.caption,
    font-family: typography.family.interface
  }
}

export FitStep = frame {
  doc: "One step of a fit: what it is and the points it adds.",
  left: 0px,
  top: 480px,
  width: 360px,
  layout: {justify-content: .space-between, item-gap: spacing.gap.regular},
  children: [label, points],

  label = text {
    width: 100%,
    fill: c.ui.text,
    contents: "Valve: Steam Deck Verified",
    font-size: typography.size.body,
    font-family: typography.family.interface
  }

  points = text {
    fill: c.ui.muted,
    contents: "+85",
    font-size: typography.size.body,
    font-family: typography.family.interface
  }
}

export FitInfo = frame {
  doc: "Modal opened by (i). Steps in order: Steam data, where you played, your rules. Fits are clamped to 0–100.",
  left: 400px,
  top: 420px,
  width: 440px,
  layout: {direction: .column, item-gap: spacing.gap.large},
  fill: c.ui.surface,
  border: c.ui.border,
  shadow: {
    drop-shadow: {
      color: rgb(0%, 0%, 0%, 19%),
      offset: point(0px, 12px),
      blur-radius: 30px
    }
  },
  corner-radius: radius.corner.panel,
  padding: 20px,
  children: [title, intro, deck, pc, rules, credit, actions],

  title = text {
    fill: c.ui.text,
    contents: "Fit for Cyberpunk 2077",
    font-size: typography.size.heading,
    font-family: typography.family.interface,
    font-style: "Bold"
  }

  intro = text {
    width: 100%,
    fill: c.ui.muted,
    contents: "Fit rates how well each setup suits this game, from 0 to 100. Steam data comes first, then where you played, then your rules. Your preference on the card always wins.",
    font-size: typography.size.caption,
    font-family: typography.family.interface
  }

  deck = frame {
    width: 100%,
    layout: {direction: .column, item-gap: spacing.gap.small},
    children: [heading, valve, controller, protonDb, rule],

    heading = frame {
      width: 100%,
      layout: {
        justify-content: .space-between,
        align-items: .center,
        item-gap: spacing.gap.medium
      },
      children: [label, total],

      label = frame {
        layout: {align-items: .center, item-gap: spacing.gap.medium},
        children: [glyph, name],

        glyph = icon {
          width: 16px,
          height: 16px,
          fill: c.ui.deck,
          contents: deckIcon
        }

        name = text {
          fill: c.ui.text,
          contents: "Steam Deck",
          font-size: typography.size.body,
          font-family: typography.family.interface,
          font-style: "Medium"
        }
      }

      total = text {
        fill: c.ui.text,
        contents: "65/100",
        font-size: typography.size.body,
        font-family: typography.family.interface,
        font-style: "Medium"
      }
    }

    valve = frame : FitStep {
      left: .auto,
      top: .auto,
      width: 100%
    }

    controller = frame : FitStep {
      left: .auto,
      top: .auto,
      width: 100%,

      label {
        contents: "Full controller support"
      }

      points {
        contents: "+5"
      }
    }

    protonDb = frame : FitStep {
      left: .auto,
      top: .auto,
      width: 100%,

      label {
        contents: "ProtonDB: 28% of 108 Deck reports note performance problems"
      }

      points {
        contents: "−10"
      }
    }

    rule = frame : FitStep {
      left: .auto,
      top: .auto,
      width: 100%,

      label {
        contents: "Your rule: Prefer PC for Open World"
      }

      points {
        contents: "−15"
      }
    }
  }

  pc = frame {
    width: 100%,
    layout: {direction: .column, item-gap: spacing.gap.small},
    children: [heading, start, highEnd, habit, rule],

    heading = frame {
      width: 100%,
      layout: {
        justify-content: .space-between,
        align-items: .center,
        item-gap: spacing.gap.medium
      },
      children: [label, total],

      label = frame {
        layout: {align-items: .center, item-gap: spacing.gap.medium},
        children: [glyph, name],

        glyph = icon {
          width: 16px,
          height: 16px,
          fill: c.ui.pc,
          contents: pcIcon
        }

        name = text {
          fill: c.ui.text,
          contents: "PC",
          font-size: typography.size.body,
          font-family: typography.family.interface,
          font-style: "Medium"
        }
      }

      total = text {
        fill: c.ui.text,
        contents: "100/100",
        font-size: typography.size.body,
        font-family: typography.family.interface,
        font-style: "Medium"
      }
    }

    start = frame : FitStep {
      left: .auto,
      top: .auto,
      width: 100%,

      label {
        contents: "Starting fit for a Windows PC"
      }

      points {
        contents: "75"
      }
    }

    highEnd = frame : FitStep {
      left: .auto,
      top: .auto,
      width: 100%,

      label {
        contents: "Your PC: High-end"
      }

      points {
        contents: "+10"
      }
    }

    habit = frame : FitStep {
      left: .auto,
      top: .auto,
      width: 100%,

      label {
        contents: "You played most hours on PC"
      }

      points {
        contents: "+10"
      }
    }

    rule = frame : FitStep {
      left: .auto,
      top: .auto,
      width: 100%,

      label {
        contents: "Your rule: Prefer PC for Open World"
      }

      points {
        contents: "+15"
      }
    }
  }

  rules = text {
    width: 100%,
    fill: c.ui.muted,
    contents: "PC is 35 points ahead, so this game is best on PC. Fits within 15 points show Both.",
    font-size: typography.size.caption,
    font-family: typography.family.interface
  }

  credit = text {
    width: 100%,
    fill: c.ui.muted,
    contents: "Contains information from ProtonDB, made available under the ODbL.",
    font-size: typography.size.caption,
    font-family: typography.family.interface
  }

  actions = frame {
    width: 100%,
    layout: {justify-content: .end, item-gap: 6px},
    children: [edit, close],

    edit = frame : buttons.Button {
      label {
        label {
          contents: "Edit rules in Settings"
        }
      }
    }

    close = frame : buttons.Primary {
      left: .auto,
      top: .auto,

      label {
        label {
          contents: "Close"
        }
      }
    }
  }
}
