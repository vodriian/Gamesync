import "tokens/colors.elyx" as c
import "design/blocks/shell/SettingsShell.elyx" as settingsSource
import "tokens/spacing.elyx" as spacing
import "tokens/typography.elyx" as typography
import "design/controls/Button.elyx" as buttons
import "design/controls/LabeledField.elyx" as labeledFields
import "resources/icons-new/chevron-down-stroke-rounded.svg" as glyph_6
import "design/blocks/settings/SettingsGroup.elyx" as settingsGroups
import "design/blocks/settings/SwitchRow.elyx" as switchRows

// Theme look: every color scheme, contrast, and accent control is visible.
// Native looks (MacOS, Windows, Omarchy) hide those rows; saved values stay.
export SettingsAppearance = frame : settingsSource.Settings {
  left: 0px,
  top: 0px,

  sections {
    navigation {
      appearance {
        fill[0].color: c.ui.selected
      }

      general {
        fill[0].color: c.ui.surface
      }
    }

    main {
      body {
        overrides: [insert(content, after = .nil)]
      }

      section {
        contents: "Look and feel"
      }
    }
  }

  content = frame : settingsGroups.SettingsGroup {
    left: 0px,
    top: 0px,
    width: 100%,
    overrides: [
      insert(choices, after = .nil),
      insert(lightRow, after = choices),
      insert(darkRow, after = lightRow),
      insert(additional, after = darkRow)
    ],

    choices = frame {
      width: 100%,
      layout: {item-gap: spacing.gap.section},
      children: [mode, look],

      mode = frame {
        width: 100%,
        layout: {direction: .column, item-gap: spacing.gap.regular},
        children: [label, options],

        label = text {
          fill: c.ui.text,
          contents: "Mode",
          font-size: typography.size.body,
          font-family: typography.family.interface,
          font-style: "Medium"
        }

        options = frame {
          layout: {item-gap: spacing.gap.medium},
          children: [auto, light, dark],

          auto = frame : buttons.Primary {
            label {
              label {
                contents: "Auto"
              }
            }
          }

          light = frame : buttons.Button {
            label {
              label {
                contents: "Light"
              }
            }
          }

          dark = frame : buttons.Button {
            label {
              label {
                contents: "Dark"
              }
            }
          }
        }
      }

      look = frame {
        width: 100%,
        layout: {direction: .column, item-gap: spacing.gap.regular},
        children: [label, options],

        label = text {
          fill: c.ui.text,
          contents: "Appearance",
          font-size: typography.size.body,
          font-family: typography.family.interface,
          font-style: "Medium"
        }

        options = frame {
          layout: {item-gap: spacing.gap.medium},
          children: [native, theme],

          native = frame : buttons.Button {
            label {
              label {
                contents: "MacOS"
              }
            }
          }

          theme = frame : buttons.Primary {
            label {
              label {
                contents: "Theme"
              }
            }
          }
        }
      }
    }

    lightRow = frame {
      width: 100%,
      layout: {item-gap: spacing.gap.section},
      children: [lightScheme, lightContrast],

      lightScheme = frame : labeledFields.LabeledField {
        input {
          value {
            trailing {
              contents: glyph_6,
              display: .visible
            }

            label {
              contents: "Sanctum"
            }
          }
        }

        label {
          contents: "Light color scheme",
          font-style: "Medium"
        }
      }

      lightContrast = frame : labeledFields.LabeledField {
        input {
          value {
            trailing {
              contents: glyph_6,
              display: .visible
            }

            label {
              contents: "Normal"
            }
          }
        }

        label {
          contents: "Light contrast",
          font-style: "Medium"
        }
      }
    }

    darkRow = frame {
      width: 100%,
      layout: {item-gap: spacing.gap.section},
      children: [darkScheme, darkContrast],

      darkScheme = frame : labeledFields.LabeledField {
        input {
          value {
            trailing {
              contents: glyph_6,
              display: .visible
            }

            label {
              contents: "Notion"
            }
          }
        }

        label {
          contents: "Dark color scheme",
          font-style: "Medium"
        }
      }

      darkContrast = frame : labeledFields.LabeledField {
        input {
          value {
            trailing {
              contents: glyph_6,
              display: .visible
            }

            label {
              contents: "Normal"
            }
          }
        }

        label {
          contents: "Dark contrast",
          font-style: "Medium"
        }
      }
    }

    additional = frame {
      width: 100%,
      layout: {direction: .column, item-gap: spacing.gap.small},
      children: [heading, motion, hidden, schemeAccent, interfaceAccent],

      heading = text {
        fill: c.ui.text,
        contents: "Additional settings",
        font-size: typography.size.body,
        font-family: typography.family.interface,
        font-style: "Medium"
      }

      motion = frame : switchRows.SwitchRow {
        label {
          contents: "Reduce motion"
        }
      }

      hidden = frame : switchRows.SwitchRow {
        label {
          contents: "Show hidden games in sidebar"
        }
      }

      schemeAccent = frame : switchRows.SwitchRow {
        label {
          contents: "Color scheme accent"
        }
      }

      interfaceAccent = frame : switchRows.SwitchRow {
        label {
          contents: "Interface accent"
        }
      }
    }
  }
}

// Native macOS look: system colors and accent; the Theme rows are hidden.
@variant
export SettingsMacOS = frame : SettingsAppearance {
  left: 1360px,
  top: 0px,

  sections {
    main {
      body {
        content {
          additional {
            interfaceAccent {
              display: .none
            }

            schemeAccent {
              display: .none
            }
          }

          darkRow {
            display: .none
          }

          lightRow {
            display: .none
          }

          choices {
            look {
              options {
                @with-variant(buttons.Button)
                theme {}

                @with-variant(buttons.Primary)
                native {}
              }
            }
          }
        }
      }
    }
  }
}

// Windows offers the same choice under its own platform name.
@variant
export SettingsWindows = frame : SettingsMacOS {
  left: 2720px,
  top: 0px,

  sections {
    main {
      body {
        content {
          choices {
            look {
              options {
                native {
                  label {
                    label {
                      contents: "Windows"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// On Linux the native choice appears only while Omarchy state is available.
// It replaces the former "Sync with Omarchy theme" checkbox.
@variant
export SettingsOmarchy = frame : SettingsMacOS {
  left: 4080px,
  top: 0px,

  sections {
    main {
      body {
        content {
          choices {
            look {
              options {
                native {
                  label {
                    label {
                      contents: "Omarchy"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
