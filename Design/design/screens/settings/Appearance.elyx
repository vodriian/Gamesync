import "tokens/colors.dark.elyx" as darkTheme
import "tokens/colors.elyx" as c
import "design/blocks/shell/SettingsShell.elyx" as settingsSource
import "tokens/spacing.elyx" as spacing
import "tokens/typography.elyx" as typography
import "design/controls/Button.elyx" as buttons
import "design/controls/TextField.elyx" as fields
import "design/controls/LabeledField.elyx" as labeledFields
import "resources/icons-new/chevron-down-stroke-rounded.svg" as glyph_6
import "design/controls/Checkbox.elyx" as checkboxes
import "design/blocks/settings/SettingsGroup.elyx" as settingsGroups

export SettingsAppearance = frame : settingsSource.Settings {
  left: 0px,
  top: 0px,

  sections {
    navigation {
      appearance {
        fill[0].color: c.ui.selected
      }

      general {
        fill[0].color: c.ui.surface
      }
    }

    main {
      body {
        overrides: [insert(content, after = .nil)]
      }

      section {
        contents: "Look and feel"
      }
    }
  }

  content = frame : settingsGroups.SettingsGroup {
    left: 0px,
    top: 0px,
    width: 100%,
    overrides: [
      insert(mode, after = .nil),
      insert(lightScheme, after = mode),
      insert(lightContrast, after = lightScheme),
      insert(darkScheme, after = lightContrast),
      insert(darkContrast, after = darkScheme),
      insert(accent, after = darkContrast),
      insert(motion, after = accent),
      insert(hidden, after = motion)
    ],

    lightScheme = frame : labeledFields.LabeledField {
      input {
        value {
          trailing {
            contents: glyph_6,
            display: .visible
          }

          label {
            contents: "Sanctum"
          }
        }
      }

      label {
        contents: "Light color scheme"
      }
    }

    lightContrast = frame : labeledFields.LabeledField {
      input {
        value {
          trailing {
            contents: glyph_6,
            display: .visible
          }

          label {
            contents: "Normal"
          }
        }
      }

      label {
        contents: "Light contrast"
      }
    }

    darkScheme = frame : labeledFields.LabeledField {
      input {
        value {
          trailing {
            contents: glyph_6,
            display: .visible
          }

          label {
            contents: "Notion"
          }
        }
      }

      label {
        contents: "Dark color scheme"
      }
    }

    darkContrast = frame : labeledFields.LabeledField {
      input {
        value {
          trailing {
            contents: glyph_6,
            display: .visible
          }

          label {
            contents: "Normal"
          }
        }
      }

      label {
        contents: "Dark contrast"
      }
    }

    accent = frame {
      layout: {
        item-gap: spacing.gap.large,
        wrap: .true,
        line-gap: spacing.gap.medium
      },
      children: [interface, scheme],

      interface = frame : checkboxes.Checked {
        label {
          contents: "Interface accent"
        }
      }

      scheme = frame : checkboxes.Checked {
        label {
          contents: "Color scheme accent"
        }
      }
    }

    mode = frame {
      width: 100%,
      layout: {direction: .column, item-gap: spacing.gap.regular},
      children: [label, choices],

      choices = frame {
        width: 100%,
        layout: {item-gap: spacing.gap.medium},
        children: [auto, light, dark],

        auto = frame : buttons.Primary {
          label {
            leading {
              display: .none
            }

            trailing {
              display: .none
            }

            detail {
              display: .none
            }

            favorite {
              display: .none
            }

            label {
              contents: "Auto"
            }
          }
        }

        light = frame : buttons.Button {
          label {
            leading {
              display: .none
            }

            trailing {
              display: .none
            }

            detail {
              display: .none
            }

            favorite {
              display: .none
            }

            label {
              contents: "Light"
            }
          }
        }

        dark = frame : buttons.Button {
          label {
            leading {
              display: .none
            }

            trailing {
              display: .none
            }

            detail {
              display: .none
            }

            favorite {
              display: .none
            }

            label {
              contents: "Dark"
            }
          }
        }
      }

      label = text {
        fill: c.ui.text,
        contents: "Mode",
        font-size: typography.size.body,
        font-family: typography.family.interface
      }
    }

    motion = frame : checkboxes.Checkbox {
      label {
        contents: "Reduce motion"
      }
    }

    hidden = frame : checkboxes.Checkbox {
      label {
        contents: "Show hidden games in sidebar"
      }
    }
  }
}

@variant
export SettingsOmarchy = frame : SettingsAppearance {
  left: 1360px,
  top: 0px,

  sections {
    main {
      body {
        content {
          overrides: [
            insert(omarchy, after = .nil),
            insert(note, after = omarchy),
            insert(scheme, after = SettingsAppearance.content.mode),
            remove(SettingsAppearance.content.accent),
            remove(SettingsAppearance.content.darkContrast),
            remove(SettingsAppearance.content.darkScheme),
            remove(SettingsAppearance.content.lightScheme),
            remove(SettingsAppearance.content.lightContrast)
          ],

          mode {
            overrides: [
              insert(input, after = SettingsAppearance.content.mode.label),
              remove(SettingsAppearance.content.mode.choices)
            ],
            layout.item-gap: spacing.gap.icon
          }
        }
      }
    }
  }

  omarchy = frame : checkboxes.Checked {
    label {
      contents: "Sync with Omarchy theme"
    }
  }

  note = text {
    left: 0px,
    top: 0px,
    width: 100%,
    fill: c.ui.muted,
    contents: "Use the active Omarchy theme on this Linux computer.",
    font-size: typography.size.body,
    font-family: typography.family.interface
  }

  input = frame : fields.TextField {
    left: 0px,
    top: 0px,
    width: 100%,

    value {
      leading {
        display: .none
      }

      trailing {
        display: .none
      }

      detail {
        display: .none
      }

      favorite {
        display: .none
      }

      label {
        contents: "Dark"
      }
    }
  }

  scheme = frame : labeledFields.LabeledField {
    input {
      value {
        label {
          contents: "Controlled by Omarchy"
        }
      }
    }

    label {
      contents: "Color scheme"
    }
  }
}
