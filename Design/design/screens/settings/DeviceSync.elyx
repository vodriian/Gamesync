    contents: "This device: Finish the community center.\nGaming PC: Start a new farm.",
    font-size: typography.size.body,
    font-family: typography.family.interface
  }

  noteChoices = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    layout: {item-gap: spacing.gap.regular},
    children: [keepLocal, keepOther],

    keepLocal = frame : buttons.Button {
      label {
        leading {
          display: .none
