    label {
      leading {
        display: .none
      }

      trailing {
        display: .none
      }

      detail {
        display: .none
      }

      favorite {
        display: .none
      }

      label {
        contents: "Turn on key sync"
      }
    }
  }
}

@variant
export SyncReviewChanges = frame : SyncOff {
  left: 1360px,
  top: 1960px,

  sections {
    main {
      body {
        content {
          overrides: [
            insert(game, after = SyncOff.content.info),
            insert(choices, after = game),
            insert(notes, after = choices),
            insert(sample, after = notes),
            insert(noteChoices, after = sample),
            remove(SyncOff.content.choose),
            remove(SyncOff.content.offline)
          ],

          info {
            contents: "Different values arrived from another computer. Choose the value to keep."
          }

          heading {
            contents: "Review changes"
          }
        }
      }
    }
  }

  game = text {
