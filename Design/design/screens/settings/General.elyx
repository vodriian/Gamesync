@variant
export SteamKeyTestFailed = frame : SettingsGeneral {
  left: 1360px,
  top: 980px,

  header {
    feedback {
      contents: "Key test failed. Check the key and profile."
    }
  }

  sections {
    main {
      body {
        content {
          country {
            height: .nil
          }

          saveCountry {
            width: .nil
          }
        }
      }
    }
  }
}
