export Grid = frame : librarySource.Library {
  doc: "02 · Library views / Grid",
  left: 0px,
  top: 0px,

  panel {
    body {
      overrides: [insert(content, after = .nil)]
    }
  }

  content = frame : gridContent.GridContent {
    width: 100%
  }
}

