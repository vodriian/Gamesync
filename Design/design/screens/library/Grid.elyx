}

@variant
export GroupedLibrary = frame : Grid {
  left: 2720px,
  top: 980px,

  panel {
    body {
      content {
        overrides: [
          insert(playing, after = .nil),
          insert(playingGames, after = playing),
          insert(completed, after = playingGames),
          insert(completedGames, after = completed),
          remove(gridContent.GridContent.game8),
          remove(gridContent.GridContent.game7),
          remove(gridContent.GridContent.game5),
          remove(gridContent.GridContent.game0),
          remove(gridContent.GridContent.game4),
          remove(gridContent.GridContent.game6),
          remove(gridContent.GridContent.game2),
          remove(gridContent.GridContent.game3),
          remove(gridContent.GridContent.game1)
        ],
        layout.direction: .column,
        layout.item-gap: 20px,
        layout.wrap: .false,
        layout.line-gap: 0
      }
    }
  }

  playing = text {
    left: 0px,
    top: 0px,
    fill: c.ui.text,
    contents: "Playing",
    font-size: typography.size.title,
    font-family: typography.family.interface
  }

  playingGames = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    layout: {item-gap: 23px, wrap: .true, line-gap: 22px},
    children: [game0, game1, game2],

    game0 = frame : gridTileSource.GridTile {
      meta {
        leading {
          display: .none
        }

        favorite {
          display: .none
        }

        trailing {
          contents: glyph_0,
          sizing: .fill,
          display: .visible
        }

        detail {
          contents: "4.5",
          display: .visible
        }

        label {
          contents: "Playing"
        }
      }
    }

    game1 = frame : gridTileSource.GridTile {
      cover {
        fill[0].image.ref: cover646570
      }

      meta {
        leading {
          display: .none
        }

        favorite {
          display: .none
        }

        trailing {
          contents: glyph_0,
          sizing: .fill,
          display: .visible
        }

        detail {
          contents: "4.5",
          display: .visible
        }

        label {
          contents: "Playing"
        }
      }

      title {
        contents: "Slay the Spire"
      }
    }

    game2 = frame : gridTileSource.GridTile {
      cover {
        fill[0].image.ref: cover2379780
      }

      meta {
        leading {
          display: .none
        }

        favorite {
          display: .none
        }

        trailing {
          contents: glyph_0,
          sizing: .fill,
          display: .visible
        }

        detail {
          contents: "4.5",
          display: .visible
        }

        label {
          contents: "Playing"
        }
      }

      title {
        contents: "Balatro"
      }
    }
  }

  completed = text {
    left: 0px,
    top: 0px,
    fill: c.ui.text,
    contents: "Completed",
    font-size: typography.size.title,
    font-family: typography.family.interface
  }

  completedGames = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    layout: {item-gap: 23px, wrap: .true, line-gap: 22px},
    children: [game0, game1],

    game0 = frame : gridTileSource.GridTile {
      cover {
        fill[0].image.ref: cover620
      }

      meta {
        leading {
          display: .none
        }

        favorite {
          display: .none
        }

        trailing {
          contents: glyph_0,
          sizing: .fill,
          display: .visible
        }

        detail {
          contents: "5.0",
          display: .visible
        }

        label {
          contents: "Completed"
        }
      }

      title {
        contents: "Portal 2"
      }
    }

    game1 = frame : gridTileSource.GridTile {
      cover {
        fill[0].image.ref: cover1055540
      }

      meta {
        leading {
          display: .none
        }

        favorite {
          display: .none
        }

        trailing {
          contents: glyph_0,
          sizing: .fill,
          display: .visible
        }

        detail {
          contents: "4.5",
          display: .visible
        }

        label {
          contents: "Completed"
        }
      }

      title {
        contents: "A Short Hike"
      }
    }
  }
}

