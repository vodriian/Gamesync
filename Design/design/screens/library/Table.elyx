@variant
export TableSelection = frame : Table {
  left: 1360px,
  top: 0px,

  panel {
    body {
      content {
        overrides: [
          insert(bulk, after = .nil),
          move(Table.content.header, after = bulk)
        ],

        row0 {
          fill[0].color: c.ui.selected,

          checkbox {
            box {
              fill[0].color: c.ui.accent,

              glyph {
                fill[0].color: .white,
                display: .visible
              }
            }
          }
        }

        row1 {
          fill[0].color: c.ui.selected,

          checkbox {
            box {
              fill[0].color: c.ui.accent,

              glyph {
                fill[0].color: .white,
                display: .visible
              }
            }
          }
        }

        row2 {
          fill[0].color: c.ui.selected,

          checkbox {
            box {
              fill[0].color: c.ui.accent,

              glyph {
                fill[0].color: .white,
                display: .visible
              }
            }
          }
        }
      }
    }
  }

  bulk = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    layout: {item-gap: spacing.gap.regular},
    children: [count, favorite, status, collections, hide, clear],

    count = text {
      fill: c.ui.text,
      contents: "3 selected",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    favorite = frame : buttons.Button {
      label {
        leading {
          display: .none
        }

        trailing {
          display: .none
        }

        detail {
          display: .none
        }

        favorite {
          display: .none
        }

        label {
          contents: "Favorite"
        }
      }
    }

    status = frame : buttons.Button {
      label {
        leading {
          display: .none
        }

        detail {
          display: .none
        }

        favorite {
          display: .none
        }

        trailing {
          contents: glyph_6,
          display: .visible
        }

        label {
          contents: "Status"
        }
      }
    }

    collections = frame : buttons.Button {
      label {
        leading {
          display: .none
        }

        detail {
          display: .none
        }

        favorite {
          display: .none
        }

        trailing {
          contents: glyph_6,
          display: .visible
        }

        label {
          contents: "Collections"
        }
      }
    }

    hide = frame : buttons.Button {
      label {
        leading {
          display: .none
        }

        trailing {
          display: .none
        }

        detail {
          display: .none
        }

        favorite {
          display: .none
        }

        label {
          contents: "Hide"
        }
      }
    }

    clear = frame : buttons.Button {
      label {
        leading {
          display: .none
        }

        trailing {
          display: .none
        }

        detail {
          display: .none
        }

        favorite {
          display: .none
        }

        label {
          contents: "Clear"
        }
      }
    }
  }
}

@variant
export BulkPartialFailure = frame : TableSelection {
  left: 2720px,
  top: 0px,

  panel {
    body {
      overrides: [insert(warning, after = .nil)],
      layout.item-gap: spacing.gap.large
    }
  }

  warning = frame {
    width: 100%,
    height: .auto,
    layout: {align-items: .center},
    fill: c.ui.chrome,
    border: c.ui.border,
    corner-radius: radius.corner.control,
    padding: 10px,
    children: message,

    message = text {
      fill: c.ui.muted,
      contents: "Some games could not be saved. Failed games remain selected.",
      font-size: 13,
      font-family: typography.family.interface
    }
  }
}

@variant
export TableInlineStatus = frame : Table {
  left: 0px,
  top: 980px,

  overlay {
    overrides: [insert(popover, after = .nil)]
  }

  popover = frame : menuSource.Menu {
    doc: "Intentional popup overlay; excluded from the content stack.",
    top: 140px,
    right: 24px,
    width: 218px,
    ignore-stack: .true,
    overrides: [
      insert(item0, after = .nil),
      insert(item1, after = item0),
      insert(item2, after = item1),
      insert(item3, after = item2),
      insert(item4, after = item3),
      insert(item5, after = item4)
    ],

    item0 = frame : menuItems.MenuItem {
      label {
        label {
          contents: "Backlog"
        }
      }
    }

    item1 = frame : menuItems.MenuItem {
      label {
        label {
          contents: "Want to play"
        }
      }
    }

    item2 = frame : menuItems.MenuItem {
      label {
        label {
          contents: "Playing"
        }

        leading {
          display: .visible
        }
      }
    }

    item3 = frame : menuItems.MenuItem {
      label {
        label {
          contents: "Paused"
        }
      }
    }

    item4 = frame : menuItems.MenuItem {
      label {
        label {
          contents: "Completed"
        }
      }
    }

    item5 = frame : menuItems.MenuItem {
      label {
        label {
          contents: "Dropped"
        }
      }
    }
  }
}

@variant
export TableInlineRating = frame : Table {
  left: 1360px,
  top: 980px,

  overlay {
    overrides: [insert(popover, after = .nil)]
  }

  popover = frame : menuSource.Menu {
    doc: "Intentional popup overlay; excluded from the content stack.",
    top: 140px,
    right: 24px,
    width: 218px,
    ignore-stack: .true,
    overrides: [
      insert(item0, after = .nil),
      insert(item1, after = item0),
      insert(item2, after = item1),
      insert(item3, after = item2),
      insert(item4, after = item3),
      insert(item5, after = item4)
    ],

    item0 = frame : menuItems.MenuItem {
      label {
        label {
          contents: "Unrated"
        }
      }
    }

    item1 = frame : menuItems.MenuItem {
      overrides: [
        insert(rating, after = .nil),
        remove(menuItems.MenuItem.label)
      ],

      rating = frame : ratingControl.Rating {
        star2 {
          display: .none,
          contents: ratingOutline
        }

        star3 {
          display: .none,
          contents: ratingOutline
