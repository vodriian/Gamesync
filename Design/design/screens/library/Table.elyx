        grid {
          fill[0].color: c.ui.surface
        }
      }
    }
  }

  content = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    layout: {direction: .column},
    children: [header, row0, row1, row2, row3, row4, row5, row6, row7, row8],

    header = frame {
      width: 100%,
      height: 32px,
      layout: {align-items: .center, item-gap: spacing.gap.large},
      padding: [0px, 12px],
      children: [check, title, status, rating, hours],

      check = frame : checkboxes.Checkbox {
        width: 61px,

        label {
          display: .none
        }
      }

      title = text {
        width: 100%,
        fill: c.ui.muted,
        contents: "Title",
        font-size: typography.size.caption,
        font-family: typography.family.interface
