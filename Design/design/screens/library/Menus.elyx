import "tokens/colors.dark.elyx" as darkTheme
import "design/blocks/shell/LibraryShell.elyx" as librarySource
import "resources/icons-new/chevron-right-stroke-rounded.svg" as glyph_8
import "resources/icons-new/check-stroke-rounded.svg" as glyph_10
import "design/blocks/menus/Menu.elyx" as menuSource
import "design/blocks/library/GridContent.elyx" as gridContent
import "design/controls/MenuItem.elyx" as menuItems
import "design/screens/library/Wishlist.elyx" as wishlistSource

export DisplayMenu = frame : librarySource.Library {
  doc: "05 · Menus / DisplayMenu",
  left: 0px,
  top: 0px,

  panel {
    body {
      overrides: [insert(content, after = .nil)]
    }
  }

  overlay {
    overrides: [insert(popover, after = .nil)]
  }

  content = frame : gridContent.GridContent {
    width: 100%
  }

  popover = frame : menuSource.Menu {
    doc: "Intentional popup overlay; excluded from the content stack.",
    top: 66px,
    right: 24px,
    width: 218px,
    ignore-stack: .true,
    overrides: [
      insert(item0, after = .nil),
      insert(item1, after = item0),
      insert(item2, after = item1),
      insert(item3, after = item2)
    ],

    item0 = frame : menuItems.MenuItem {
      label {
        trailing {
          contents: glyph_8,
          display: .visible
        }

        label {
          contents: "Filter"
        }
      }
    }

    item1 = frame : menuItems.MenuItem {
      label {
        trailing {
          contents: glyph_8,
          display: .visible
        }

        label {
          contents: "Sort by"
        }
      }
    }

    item2 = frame : menuItems.MenuItem {
      label {
        trailing {
          contents: glyph_8,
          display: .visible
        }

        label {
          contents: "Group by"
        }
      }
    }

    item3 = frame : menuItems.MenuItem {
      label {
        trailing {
          contents: glyph_8,
          display: .visible
        }

        label {
          contents: "View"
        }
      }
    }
  }
}

