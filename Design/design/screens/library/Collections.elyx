    }

    label = text {
      fill: c.ui.text,
      contents: "Notes",
      font-size: typography.size.body,
      font-family: typography.family.interface
    }

    input = frame {
      width: 100%,
      height: 130px,
      layout: {direction: .column, item-gap: spacing.gap.regular},
      border: c.ui.border,
      corner-radius: radius.corner.control,
      padding: 10px,
      children: value,

      value = text {
        fill: c.ui.text,
        contents: "Finish the community center.",
        font-size: typography.size.body,
        font-family: typography.family.interface
      }
    }

    actions = frame {
      width: 100%,
      layout: {item-gap: 6px},
      children: [cancel, save],

      save = frame : buttons.Primary {
        label {
          leading {
            display: .none
          }

          trailing {
            display: .none
          }

          detail {
            display: .none
          }

          favorite {
            display: .none
          }

          label {
            contents: "Save"
          }
        }
      }

      cancel = frame : buttons.Button {
        label {
          leading {
            display: .none
          }

          trailing {
            display: .none
          }

          detail {
            display: .none
          }

          favorite {
            display: .none
          }

          label {
            contents: "Cancel"
          }
        }
      }
    }
  }
}
