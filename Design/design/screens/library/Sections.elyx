        contents: glyph_0,
        sizing: .fill,
        display: .visible
      }

      detail {
        contents: "5.0",
        display: .visible
      }

      label {
        contents: "Completed"
      }
    }

    title {
      contents: "Portal 2"
    }
  }

  indie = frame : rows.NavigationRow {
    padding-left: 40px,
    fill[0].color: c.ui.selected,

    glyph {
      display: .none
    }

    count {
      contents: "6"
    }

    labelArea {
      label {
        contents: "Indie"
      }
    }
  }
}

@variant
export HiddenGames = frame : Favorites {
  left: 0px,
  top: 980px,

  overlay {
    overrides: [insert(popover, after = .nil)]
  }

  panel {
    count {
      label {
        contents: "1 game ·"
      }
    }

    body {
      content {
        overrides: [
          remove(gridContent.GridContent.game4),
          remove(gridContent.GridContent.game1),
          remove(gridContent.GridContent.game3),
          remove(gridContent.GridContent.game2)
        ],

        game0 {
          cover {
            fill[0].image.ref: cover1091500
          }

          meta {
            detail {
              contents: "—"
            }

            label {
              contents: "Backlog"
            }
          }

          title {
            contents: "Cyberpunk 2077"
          }
        }
      }
    }

    toolbar {
      title {
        contents: "Hidden games"
      }
    }
  }

  sidebar {
    navigation {
      hidden {
        fill[0].color: c.ui.selected,
        display: .visible
      }

      favorites {
        fill[0]: .nil,

        glyph {
          contents: favoritesOutline,
          sizing: .fit
        }
      }
    }
  }

  popover = frame : menuSource.Menu {
    doc: "Intentional popup overlay; excluded from the content stack.",
    left: 490px,
    top: 270px,
    width: 218px,
    ignore-stack: .true,
    overrides: [
      insert(item0, after = .nil),
      insert(item1, after = item0),
      insert(item2, after = item1)
    ],

    item0 = frame : menuItems.MenuItem {
      label {
        label {
          contents: "Unhide"
        }
      }
    }

    item1 = frame : menuItems.MenuItem {
      label {
        trailing {
          contents: glyph_8,
          display: .visible
        }

        label {
          contents: "Status"
        }
      }
    }

    item2 = frame : menuItems.MenuItem {
      label {
        trailing {
          contents: glyph_8,
          display: .visible
        }

        label {
          contents: "Collections"
        }
      }
    }
  }
}
