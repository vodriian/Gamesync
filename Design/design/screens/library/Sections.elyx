      collection {
        fill[0].color: c.ui.selected,

        glyph {
          contents: collectionSolid,
          sizing: .fit
        }
      }

      favorites {
        fill[0]: .nil,

        glyph {
          contents: favoritesOutline,
          sizing: .fit
        }
      }
    }
  }
}

@variant
export SmartCollection = frame : Favorites {
  left: 2720px,
  top: 0px,

  panel {
    count {
