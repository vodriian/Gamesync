@variant
export DetailsBestOnExpanded = frame : CardDetails {
  left: 1360px,
  top: 2940px,

  overlay {
    display: .hidden
  }

  body {
    content {
      stage {
        book {
          right {
            bestOn {
              details {
                preferenceNote {
                  display: .none
                }

                display: .visible
              }

              toggle {
                button {
                  label {
                    label {
                      contents: "Fewer details"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

@variant
export DetailsNoBestOn = frame : CardDetails {
  doc: "Games without Steam Deck evidence show no Best on block.",
  left: 2720px,
  top: 2940px,

  body {
    content {
      stage {
        book {
          right {
            bestOn {
              display: .none
            }
          }
        }
      }
    }
  }
}

pc = frame {
  left: 2141.47px,
  top: 4476.48px,
  width: 100%,
  height: 63px,
  layout: {direction: .column, item-gap: 6px},
  fill: c.ui.surface,
  border: c.ui.border,
  corner-radius: radius.corner.control,
  padding: spacing.inset.small,
  children: [bar, blocker],

  bar = frame {
    width: 100%,
    height: 4px,
    layout: {direction: .row},
    fill: c.ui.border,
    corner-radius: 2px,
    children: value
  }

  value = frame {
    width: 75%,
    height: 100%,
    opacity: 0.4,
    fill: c.ui.text,
    corner-radius: 2px
  }

  blocker = text {
    width: 100%,
    display: .none,
    fill: c.ui.error,
    contents: "Not supported: anti-cheat.",
    font-size: typography.size.caption,
    font-family: typography.family.interface
  }
}
