@variant
export HomeDisconnected = frame : Home {
  left: 1360px,
  top: 0px,

  panel {
    body {
      content {
        overrides: [
          insert(intro, after = .nil),
          insert(connect, after = intro),
          insert(recentReplacement, after = connect),
          insert(recentEmpty, after = recentReplacement),
          insert(platforms, after = recentEmpty),
          insert(platformEmpty, after = platforms),
          insert(genres, after = platformEmpty),
          insert(genresEmpty, after = genres),
          insert(favoritesEmpty, after = Home.content.favorites),
          insert(collectionsEmpty, after = Home.content.collections),
          remove(Home.content.stats),
          remove(Home.content.favoritesRow),
          remove(Home.content.recent),
          remove(Home.content.collection),
          remove(Home.content.heading)
        ],

        collections {
          fill[0].color: c.ui.text
        }

        favorites {
          fill[0].color: c.ui.text,
          font-style: .nil
        }
      }
    }
  }

  intro = text {
    left: 0px,
    top: 0px,
    width: 100%,
    fill: c.ui.muted,
    contents: "Connect Steam to import your games and playtime.",
    font-size: typography.size.body,
    font-family: typography.family.interface
  }

  connect = frame : buttons.Primary {
    left: 0px,
    top: 0px,

    label {
      leading {
        display: .none
      }

      trailing {
        display: .none
      }

      detail {
        display: .none
      }

      favorite {
        display: .none
      }

      label {
        contents: "Connect Steam"
      }
    }
  }

  recentReplacement = text {
    left: 0px,
    top: 0px,
    fill: c.ui.text,
    contents: "Continue playing",
    font-size: 15,
    font-family: typography.family.interface
  }

  recentEmpty = text {
    left: 0px,
    top: 0px,
    width: 100%,
    fill: c.ui.muted,
    contents: "Sync Steam to see recent games.",
    font-size: typography.size.body,
    font-family: typography.family.interface
  }

  platforms = text {
    left: 0px,
    top: 0px,
    fill: c.ui.text,
    contents: "Playtime by platform",
    font-size: 15,
    font-family: typography.family.interface
  }

  platformEmpty = text {
    left: 0px,
    top: 0px,
    width: 100%,
    fill: c.ui.muted,
    contents: "No Steam playtime yet.",
    font-size: typography.size.body,
    font-family: typography.family.interface
  }

  genres = text {
    left: 0px,
    top: 0px,
    fill: c.ui.text,
    contents: "Favorite genres",
    font-size: 15,
    font-family: typography.family.interface
  }

  genresEmpty = text {
    left: 0px,
    top: 0px,
    width: 100%,
    fill: c.ui.muted,
    contents: "Genres appear after a Steam sync.",
    font-size: typography.size.body,
    font-family: typography.family.interface
  }

  favoritesEmpty = text {
    left: 0px,
    top: 0px,
    width: 100%,
    fill: c.ui.muted,
    contents: "Mark games as favorites to see them here.",
    font-size: typography.size.body,
    font-family: typography.family.interface
  }

  collectionsEmpty = text {
    left: 0px,
    top: 0px,
    width: 100%,
    fill: c.ui.muted,
    contents: "Create a collection in the sidebar to see it here.",
    font-size: typography.size.body,
    font-family: typography.family.interface
  }
}
